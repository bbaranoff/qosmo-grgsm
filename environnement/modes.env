# =============================================================================
#  config/modes.env — profils prêts à l'emploi
# =============================================================================
#  Un profil = un jeu cohérent de variables. Choisissez-en UN, ne les mélangez pas.
#  Activez-en un en posant CALYPSO_MODE avant le lancement :
#      CALYPSO_MODE=shunt_legit ./run.sh
# -----------------------------------------------------------------------------

: "${CALYPSO_MODE:=shunt_legit}"

case "$CALYPSO_MODE" in

  # ---------------------------------------------------------------------------
  # LE SEUL MODE. Le mobile campe, s'enregistre (LU + TMSI) et échange des SMS.
  # La détection FB/SB est calculée côté hôte par gr-gsm, pas par un DSP émulé.
  #
  # LES SIX AUTRES MODES ONT ÉTÉ RETIRÉS, et ce n'est pas un allègement : ils
  # n'ont plus d'objet. `native`, `native_helped`, `native_twl`,
  # `native_twl_host_demod` faisaient tourner l'émulation du TMS320C54x pour
  # savoir ce qu'elle valait — question close, cette release abandonne
  # l'émulation du DSP. `shunt_legit_no_inject` et `empty` étaient des points de
  # comparaison CONTRE le natif : sans natif, ils ne comparent plus rien.
  #
  # Un mode qu'on ne peut plus exercer est pire qu'un mode absent : il reste
  # dans le menu, quelqu'un le choisit, et le banc part dans une configuration
  # que personne ne teste plus. La branche `*)` ci-dessous le dit franchement
  # plutôt que de laisser un profil silencieusement à moitié posé.
  # ---------------------------------------------------------------------------
  shunt_legit)
      : "${CALYPSO_SHUNT_LEGIT:=1}"
      # ── LE FILET DES VALEURS PRE-CALCULEES : REACTIVE ───────────────────────
      # CALYPSO_SHUNT_NO_CANNED passe de 1 a 0.
      #
      # CE QUE CA CHANGE, exactement (calypso_dsp_helper.c:386 et :538) :
      #   à 1 — tant que gr-gsm n'a pas livre un SCH reel, le SB n'est PAS
      #         dispatche ; tant qu'il n'a pas livre un SI reel, rien n'est
      #         presente dans a_cd. Le firmware attend, comme un vrai mobile.
      #   à 0 — le shunt retombe sur les valeurs pre-calculees quand le demod
      #         n'a rien livre.
      #
      # POURQUOI C'EST UN ARBITRAGE ET PAS UNE AMELIORATION. Le commentaire
      # d'origine dit la raison d'etre du 1 : « si le demod casse, rien ne campe
      # (le bug est visible, pas masque par le canned) ». En passant a 0 on
      # RETROUVE un banc qui campe, et on PERD cette garantie : une defaillance
      # de gr-gsm ne se verra plus dans le comportement, seulement dans les
      # compteurs.
      #
      # A SURVEILLER en consequence, puisque le symptome ne previendra plus :
      # les journaux « (gr-gsm REEL) » contre « (canned legacy) » dans qemu.log
      # disent, bloc par bloc, laquelle des deux sources a servi. Un banc qui
      # campe sur du canned n'est PAS un banc en gr-gsm pur.
      : "${CALYPSO_SHUNT_NO_CANNED:=0}"
      : "${CALYPSO_SHUNT_REAL_FB:=1}"
      ;;

  *)
      echo "[modes.env] CALYPSO_MODE='$CALYPSO_MODE' n'existe plus." >&2
      echo "            Cette release n'a qu'UN mode : shunt_legit (gr-gsm pur)." >&2
      echo "            Les modes natifs ont ete retires avec l'emulation du DSP." >&2
      echo "            -> on retombe sur shunt_legit." >&2
      # PAS d'affectation directe "CALYPSO_MODE=..." : le module 20-handoff
      # cherche exactement ce motif dans environnement/ et echoue dessus, a
      # juste titre. Une CALYPSO_* affectee en dur ici ECRASERAIT ce que
      # l'utilisateur passe sur la ligne de commande - et c'est toute la
      # discipline de ce repertoire : on POSE UN DEFAUT, on n'impose pas.
      #
      # unset puis ":=" fait la normalisation sans le verrou : la variable
      # redevient vide, le defaut s'applique, et la ligne ne ressemble plus a
      # un ecrasement - parce que ce n'en est plus un. On ne le fait que pour
      # un mode qui N'EXISTE PLUS : il n'y a rien a honorer, et le message
      # ci-dessus a deja dit ce qu'on en fait.
      unset CALYPSO_MODE
      : "${CALYPSO_MODE:=shunt_legit}"
      : "${CALYPSO_SHUNT_LEGIT:=1}"
      : "${CALYPSO_SHUNT_NO_CANNED:=1}"
      : "${CALYPSO_SHUNT_REAL_FB:=1}"
      ;;
esac

# =============================================================================
#  CAPTURES I/Q — par défaut dans TOUS les modes, pour que corr_iq.py ait
#  toujours un feed à lire.                                    [2026-07-30]
# =============================================================================
#  Motif : `tools/corr_iq.py` est l'instrument de référence de la chaîne I/Q,
#  et il ne sert à rien si le run n'a rien écrit. On a perdu des runs entiers à
#  découvrir après coup que la source demandée était absente — d'où « il ne me
#  crée pas le fichier ». Ses quatre sources et ce qui les produit :
#
#    --src shunt   /dev/shm/dsp_iq.cfile      DÉJÀ par défaut côté C
#                                             (calypso_dsp_shunt.c:1637). Et le
#                                             shunt s'arme même en natif, sur
#                                             CALYPSO_DSP=c54x — donc ce fichier
#                                             existe dans tous les modes sans
#                                             qu'on pose rien.
#    --src bursts  /dev/shm/bursts.cfile      BSP_DUMP_RX_FILE  (posé ici)
#    --src rxdump  /tmp/iq_rx_*.bin           CALYPSO_IQDUMP    (posé ici)
#    --src ddump   /dev/shm/daram_2a00.cfile  CALYPSO_DARAM_DUMP (posé ici)
#
#  Coût, mesuré sur le code : `IQDUMP` est PLAFONNÉ à 24 fichiers
#  (calypso_bsp.c:1352) et `DARAM_DUMP` à 200 captures
#  (CALYPSO_DARAM_DUMP_MAX, calypso_c54x.c:16312). Les deux ne filment que les
#  bursts COHÉRENTS (coh > 0.85 = FCCH), pas tout le trafic.
#  ⚠️ `BSP_DUMP_RX_FILE` est le seul NON plafonné : ~600 o par burst FCCH, en
#     append, dans /dev/shm (donc en RAM). Sur un run de plusieurs heures,
#     surveillez-le : `ls -l /dev/shm/bursts.cfile`.
#  ⚠️ `BSP_DUMP_RX_FILE` ne porte pas le préfixe CALYPSO_ : il n'apparaît donc
#     PAS dans le manifeste du modèle. C'est la seule de ces variables dont le
#     manifeste ne dit rien — vérifiez le fichier, pas le manifeste.
#
#  Volontairement NON posé : CALYPSO_DARAM_DUMP_ANYMODE. Son défaut 0 est un
#  garde-fou acquis le 27/07 : sans lui le plafond de 200 est consommé dès le
#  boot pendant que d_fb_mode[0x08f9]==0, et on conclut à tort « le buffer ne
#  contient jamais de FCCH ». Ne l'allumez que pour une question précise.
#
#  `empty` est exclu : son contrat est de ne RIEN poser (cf. sa branche).
# Plus de branche `empty` a exclure : il n'y a qu'un mode. Le `case` est
# conserve tel quel plutot que transforme en bloc : il se termine par un
# `;;` et un `esac` plus bas, et changer l'ouverture sans changer la
# fermeture donne une erreur de syntaxe a 60 lignes de la.
case "$CALYPSO_MODE" in
  *)
      # BSP_DUMP_RX_FILE n'est PAS posé ici : calypso.env:36 le pose déjà pour
      # tous les modes (converti en `:=` le 30/07 pour être surchargeable).
      : "${CALYPSO_IQDUMP:=1}"
      : "${CALYPSO_DARAM_DUMP:=1}"
      # Le SEUL cfile que grgsm_decode sait lire. `dsp_iq.cfile` contient bien de
      # la FCCH (mesuré : pic FFT +67708 Hz, conc=121) mais gr-gsm ne s'y
      # verrouille PAS : les trames manquantes n'y sont pas comblées, donc la
      # 51-multitrame est introuvable. Ce cfile #2 rejoue les bursts à leur
      # position de FN et comble les trous (calypso_dsp_shunt.c:2076).
      # PLAFONNÉ à 512 Mo par défaut depuis le 30/07 (CALYPSO_IQ_CFILE2_MAX_MB) :
      # sans plafond c'est un flux CONTINU de 10 ko/trame = 7,8 Go/h en temps
      # réel, dans de la RAM. C'est ce plafond qui permet de l'activer par défaut.
      : "${CALYPSO_SHUNT_IQ_CFILE2:=/dev/shm/dsp_iq_fn.cfile}"
      ;;
esac
